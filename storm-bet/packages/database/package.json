{
  "name": "@storm-bet/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "generate": "node scripts/prisma.mjs generate",
    "migrate": "node scripts/prisma.mjs migrate deploy",
    "migrate:dev": "node scripts/prisma.mjs migrate dev",
    "reset": "node scripts/prisma.mjs migrate reset --force --skip-seed",
    "seed": "tsx --env-file-if-exists=../../.env src/seed/index.ts",
    "studio": "node scripts/prisma.mjs studio",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@storm-bet/config": "workspace:*",
    "@storm-bet/types": "workspace:*",
    "prisma": "6.19.3"
  },
  "devDependencies": {
    "@storm-bet/security": "workspace:*",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "files": [
    "src",
    "prisma",
    "scripts"
  ]
}
