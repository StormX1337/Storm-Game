# ─────────────────────────────────────────────────────────────────────────────
# STORM BET — environment template
#
# Copy to `.env` and fill in the secrets. Never commit `.env`.
# Every value is validated at startup (packages/config/src/env.ts); a service
# refuses to start on a missing or malformed value instead of guessing.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# Public origin of the web app. Cookies are marked Secure when this is https.
APP_URL=http://localhost:3000

# ─── Data stores ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://stormbet:stormbet@localhost:5432/stormbet?schema=public
REDIS_URL=redis://localhost:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=4000
# Where the web server reaches the API (server-side rendering and the /api proxy).
API_INTERNAL_URL=http://localhost:4000

# REQUIRED. At least 32 random characters: `openssl rand -base64 48`
AUTH_SECRET=

SESSION_TTL_HOURS=168
SESSION_IDLE_MINUTES=1440
ADMIN_SESSION_IDLE_MINUTES=30
# Which proxies' X-Forwarded-For to believe (hop count, CIDRs, or keywords).
TRUST_PROXY=loopback,uniquelocal
# Optional comma-separated CIDR allowlist for /api/admin (empty = no restriction).
ADMIN_IP_ALLOWLIST=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Store client IPs in the audit log. Disable where this is not lawful.
AUDIT_LOG_IP=true

# ─── Mail ────────────────────────────────────────────────────────────────────
# Without SMTP_URL, mails (verification, password reset) are written to the API log.
MAIL_FROM="STORM BET <no-reply@storm-bet.local>"
SMTP_URL=
SUPPORT_EMAIL=support@storm-bet.local

# ─── Betting limits (minor units: 100 = 1.00 DEMO) ──────────────────────────
BET_MIN_STAKE=10
BET_MAX_STAKE=1000000
BET_MAX_PAYOUT=25000000
BET_MAX_SELECTIONS=20
BET_MAX_TOTAL_ODDS=10000
# With "accept higher odds", never take a price that rose more than this (%).
ODDS_ACCEPT_HIGHER_MAX_PCT=10

# ─── Demo wallet ─────────────────────────────────────────────────────────────
DEMO_STARTING_BALANCE=100000
DEMO_TOPUP_AMOUNT=50000
DEMO_TOPUP_THRESHOLD=5000
DEMO_TOPUP_COOLDOWN_HOURS=24

# Real-money play is not implemented and cannot be switched on. Leave unset.
# REAL_MONEY_ENABLED=false

# ─── Odds provider / worker ──────────────────────────────────────────────────
# mock = simulated fixtures and odds (default, no network, no cost)
# theoddsapi = real fixtures, odds and results from The Odds API (see SETUP.md)
ODDS_PROVIDER=mock
MOCK_SEED=storm-bet-demo
# Simulated match minutes per real minute (1 = real time).
MOCK_TIME_SCALE=3
PROVIDER_TIMEOUT_MS=3000
PROVIDER_MAX_RETRIES=3
PROVIDER_RATE_LIMIT_PER_MINUTE=1200
PROVIDER_CACHE_TTL_SECONDS=2
CATALOG_SYNC_INTERVAL_MS=30000
LIVE_SYNC_INTERVAL_MS=3000
PREMATCH_ODDS_INTERVAL_MS=20000
SETTLEMENT_INTERVAL_MS=15000
WORKER_HEALTH_PORT=4100

# ─── The Odds API (only with ODDS_PROVIDER=theoddsapi) ──────────────────────
# REQUIRED for the real feed. Key from https://the-odds-api.com — keep it secret.
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
# Competition keys; a trailing * matches every active key with that prefix.
ODDS_API_SPORTS=soccer_germany_bundesliga,soccer_epl,soccer_spain_la_liga,soccer_uefa_champs_league,basketball_nba,basketball_euroleague,tennis_atp_*,tennis_wta_*
# Bookmaker region(s) for prices, or pin bookmakers (comma-separated keys; overrides regions).
ODDS_API_REGIONS=eu
ODDS_API_BOOKMAKERS=
# Refresh intervals per competition. Each odds refresh costs markets × regions credits,
# each scores refresh 2 credits (only while a game of that competition is running).
ODDS_API_ODDS_TTL_SECONDS=900
ODDS_API_SCORES_TTL_SECONDS=300
# Stop spending below this many remaining credits; markets are then suspended.
ODDS_API_MIN_REMAINING=25
# In-play betting on the real feed. Off by default: snapshot prices go stale quickly.
ODDS_API_LIVE_BETTING=false
# With live betting on, suspend markets whose prices are older than this.
ODDS_API_LIVE_MAX_AGE_SECONDS=60

# ─── Seed (pnpm db:seed) ─────────────────────────────────────────────────────
# Leave the passwords empty to have the seed generate and print them once.
SEED_ADMIN_EMAIL=admin@storm-bet.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=demo@storm-bet.local
SEED_DEMO_PASSWORD=

# ─── Docker Compose only ─────────────────────────────────────────────────────
POSTGRES_USER=stormbet
POSTGRES_PASSWORD=
POSTGRES_DB=stormbet
