{
  "name": "@storm-bet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --clear-screen=false src/main.ts",
    "build": "node ../../scripts/build-service.mjs src/main.ts dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@storm-bet/betting-engine": "workspace:*",
    "@storm-bet/compliance": "workspace:*",
    "@storm-bet/config": "workspace:*",
    "@storm-bet/database": "workspace:*",
    "@storm-bet/odds-engine": "workspace:*",
    "@storm-bet/redis": "workspace:*",
    "@storm-bet/security": "workspace:*",
    "@storm-bet/types": "workspace:*",
    "@storm-bet/validation": "workspace:*",
    "bullmq": "5.63.0",
    "fastify": "5.6.2",
    "fastify-plugin": "5.1.0",
    "nodemailer": "7.0.10",
    "pino": "9.14.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/nodemailer": "7.0.3",
    "esbuild": "0.25.12",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
