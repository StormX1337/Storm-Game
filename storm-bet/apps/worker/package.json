{
  "name": "@storm-bet/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --clear-screen=false src/main.ts",
    "build": "node ../../scripts/build-service.mjs src/main.ts dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts"
  },
  "dependencies": {
    "@storm-bet/betting-engine": "workspace:*",
    "@storm-bet/config": "workspace:*",
    "@storm-bet/database": "workspace:*",
    "@storm-bet/odds-engine": "workspace:*",
    "@storm-bet/redis": "workspace:*",
    "@storm-bet/types": "workspace:*",
    "bullmq": "5.63.0",
    "pino": "9.14.0",
    "@storm-bet/security": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
