# Copy to .env and fill in. Never commit the real file.

# Database password for the bundled PostgreSQL.
POSTGRES_PASSWORD=change-me

# 32+ random characters. API keys stored from the admin panel are encrypted
# with it, so it must not change once keys are saved.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FVS_SECRET_KEY=

# The origin users open in the browser (comma-separated if several).
FVS_ALLOWED_ORIGINS=http://localhost:3000

# Session cookie is Secure by default. Set to false only for plain-HTTP local use.
FVS_COOKIE_SECURE=false

# Optional: provider keys can also be entered in Admin -> API keys.
# API-Football (https://www.api-football.com) - fixtures, statistics, line-ups, injuries, odds.
FVS_API_FOOTBALL_KEY=
# The Odds API (https://the-odds-api.com) - bookmaker odds.
FVS_THE_ODDS_API_KEY=

WEB_PORT=3000
