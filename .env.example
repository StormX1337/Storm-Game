# ============================================================================
#  Storm Panel configuration
#
#  1.  cp .env.example .env
#  2.  ./scripts/generate-secrets.sh      (fills in the three secrets below)
#  3.  set APP_URL and ADMIN_* to real values
#  4.  docker compose up -d
# ============================================================================

# ------------------------------------------------------------------ panel --
APP_NAME="Storm Panel"

# The URL customers reach the panel on. Node agents also use it to call back,
# so it must be resolvable from your nodes, not just from your browser.
APP_URL=http://localhost

# Port nginx publishes on the host.
HTTP_PORT=80

LOG_LEVEL=info

# --------------------------------------------------------------- database --
POSTGRES_USER=storm
POSTGRES_DB=storm
# Required. Use a long random value.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- secrets --
# All three are required and must each be at least 32 characters.
# Generate them with: ./scripts/generate-secrets.sh
#
# Changing ENCRYPTION_KEY makes every stored secret (node tokens, database
# host passwords, SFTP passwords, 2FA seeds) permanently unreadable.
JWT_SECRET=
ENCRYPTION_KEY=
COOKIE_SECRET=

# Set to true once the panel is served over HTTPS, so session cookies are
# only sent on secure connections.
COOKIE_SECURE=false

# ---------------------------------------------------------- first account --
# Created automatically on first start. Leave ADMIN_PASSWORD blank to skip
# and create the account later with: docker compose exec api node \
#   --import tsx apps/api/src/cli/index.ts admin create --role OWNER
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ------------------------------------------------------------------- mail --
# Optional. Without SMTP the panel still works; verification and password
# reset links are written to the API log instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Storm Panel <no-reply@example.com>"

# ------------------------------------------------------------------ nodes --
# Accept node agent certificates that are not signed by a public CA. Only
# turn this on for a lab; in production give agents real certificates.
AGENT_ALLOW_SELF_SIGNED=false

# Publish the OpenAPI browser at /api/docs.
ENABLE_SWAGGER=true

# ---------------------------------------------------------------- updates --
# The panel compares itself against this repository and shows what changed.
# Checking is a plain HTTPS request and needs no credentials.
UPDATE_REPOSITORY=StormX1337/Storm-Game
UPDATE_BRANCH=main
UPDATE_CHECK_ENABLED=true

# Where the panel and the host-side updater exchange messages. Compose mounts
# this into the API already, so it only needs changing if /var/lib/storm/control
# does not suit the host.
#
# Setting it enables nothing on its own. The panel offers "Update now" only
# while scripts/storm-updater.sh is running and writing its heartbeat here. The
# API has no access to Docker and never will: it writes a request, and the host
# decides whether to act on it. Install with:
#
#   sudo ./scripts/storm-updater.sh --install && docker compose up -d api
#
STORM_CONTROL_DIR=/var/lib/storm/control

# Background jobs. Run the workers in-process (the default) or, at scale, turn
# them off on the instances serving requests and raise the multiplier on one
# dedicated worker instance instead.
ENABLE_WORKERS=true
WORKER_CONCURRENCY=1

# ------------------------------------------------- optional: local agent --
# Only needed for `docker compose --profile agent up -d`, which runs an agent
# on the same host as the panel. Fill these from `storm node create`.
AGENT_NODE_UUID=
AGENT_TOKEN_ID=
AGENT_TOKEN=
AGENT_SECRET=
AGENT_PANEL_URL=http://api:8080
AGENT_PORT=8081
AGENT_SFTP_PORT=2022
AGENT_DATA_DIR=/var/lib/storm/servers
AGENT_BACKUP_DIR=/var/lib/storm/backups

# ----------------------------------------------- optional: MinIO storage --
# Only needed for `docker compose --profile storage up -d`.
MINIO_ROOT_USER=storm
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
