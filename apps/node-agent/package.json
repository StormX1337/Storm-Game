    "archiver": "7.0.1",
    "dockerode": "4.0.4",
    "fastify": "5.2.1",
    "fastify-plugin": "5.0.1",
    "pino": "9.6.0",
    "ssh2": "1.16.0",
    "systeminformation": "5.25.11",
    "tar": "7.4.3",
    "undici": "7.2.3",
    "unzipper": "0.12.3",
    "ws": "8.18.0",
    "yaml": "^2.9.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/dockerode": "3.3.34",
    "@types/node": "22.10.5",
    "@types/ssh2": "1.15.4",
    "@types/unzipper": "0.10.10",
