{
  "name": "@storm/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-timeout=120000 test/*.test.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.723.0",
    "@aws-sdk/s3-request-presigner": "3.723.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.0.2",
    "@fastify/rate-limit": "10.2.2",
    "@fastify/sensible": "6.0.3",
    "@fastify/swagger": "9.4.0",
    "@fastify/swagger-ui": "5.2.0",
    "@fastify/websocket": "11.0.2",
    "@storm/config": "workspace:*",
    "@storm/database": "workspace:*",
    "@storm/security": "workspace:*",
    "@storm/types": "workspace:*",
    "bullmq": "5.34.10",
    "commander": "12.1.0",
    "cron-parser": "4.9.0",
    "fastify": "5.2.1",
    "fastify-plugin": "5.0.1",
    "ioredis": "5.4.2",
    "mysql2": "3.12.0",
    "nodemailer": "6.9.16",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "undici": "7.2.3",
    "unzipper": "0.12.3",
    "ws": "8.18.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.11.10",
    "@types/unzipper": "0.10.10",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
