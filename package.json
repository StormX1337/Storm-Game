{
  "name": "storm-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Storm Panel — a modern game server hosting control panel",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "pnpm run build:packages && pnpm --filter @storm/api run build && pnpm --filter @storm/node-agent run build && pnpm --filter @storm/web run build",
    "build:packages": "pnpm --filter @storm/types run build && pnpm --filter @storm/config run build && pnpm --filter @storm/security run build && pnpm --filter @storm/database run build",
    "dev": "pnpm run build:packages && concurrently -n api,web,agent -c blue,magenta,green \"pnpm --filter @storm/api run dev\" \"pnpm --filter @storm/web run dev\" \"pnpm --filter @storm/node-agent run dev\"",
    "dev:api": "pnpm --filter @storm/api run dev",
    "dev:web": "pnpm --filter @storm/web run dev",
    "dev:agent": "pnpm --filter @storm/node-agent run dev",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css,yml}\"",
    "test": "pnpm -r --no-bail test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "db:generate": "pnpm --filter @storm/database run generate",
    "db:migrate": "pnpm --filter @storm/database run migrate",
    "db:deploy": "pnpm --filter @storm/database run deploy",
    "db:reset": "pnpm --filter @storm/database run reset",
    "db:seed": "pnpm --filter @storm/database run seed",
    "db:studio": "pnpm --filter @storm/database run studio",
    "storm": "node --import tsx apps/api/src/cli/index.ts",
    "clean": "rm -rf node_modules **/node_modules **/dist apps/web/.next",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@next/eslint-plugin-next": "15.1.4",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "concurrently": "9.1.2",
    "eslint": "9.18.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "argon2",
      "ssh2",
      "cpu-features",
      "sharp",
      "@swc/core",
      "unrs-resolver",
      "protobufjs",
      "bufferutil",
      "utf-8-validate"
    ]
  }
}
