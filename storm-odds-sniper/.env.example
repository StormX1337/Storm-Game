# ============================================================================
#  Storm Odds Sniper - Konfiguration
#  Kopieren nach .env und anpassen:  cp .env.example .env
#  Die .env gehört NIEMALS ins Git (siehe .gitignore).
# ============================================================================

# ---------------------------------------------------------------- Allgemein
ENVIRONMENT=production
LOG_LEVEL=INFO
# true = JSON-Logs (für Loki/ELK), false = lesbare Konsolenausgabe
LOG_JSON=true

# ---------------------------------------------------------------- Datenbank
POSTGRES_DB=storm
POSTGRES_USER=storm
# PFLICHT: sicheres Passwort setzen, z. B. mit  openssl rand -base64 24
POSTGRES_PASSWORD=
# Optional: vollständige DSN, überschreibt die Einzelwerte oben
# DATABASE_URL=postgresql+asyncpg://storm:passwort@postgres:5432/storm

# -------------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=512mb

# ----------------------------------------------------------------- Telegram
# Token vom @BotFather. Ohne Token startet nur der Telegram-Worker nicht -
# Scanner, API und Dashboard laufen weiter.
TELEGRAM_BOT_TOKEN=
# Ziel-Chat für Alarme (eigene ID über @userinfobot; Gruppen-IDs sind negativ).
# Mehrere Chats kommagetrennt.
TELEGRAM_CHAT_ID=
# Telegram-IDs mit Adminrechten (kommagetrennt)
TELEGRAM_ADMIN_IDS=
# Bewegungsalarme zusätzlich per Telegram schicken (Standard: nur Dashboard)
TELEGRAM_SEND_MOVES=false

# ================================================================= PROVIDER
# Kommagetrennte Liste aktiver Datenquellen.
#   mock          - Simulation, funktioniert ohne Zugangsdaten (Standard)
#   the_odds_api  - the-odds-api.com, API-Key nötig
#   betfair       - Betfair Exchange, Konto + App-Key nötig
# Mehrere Quellen parallel:  PROVIDERS=the_odds_api,betfair
#
# ACHTUNG: 'mock' NICHT neben einer echten Quelle laufen lassen. Die Simulation
# erzeugt am laufenden Band künstliche Fehlpreise, die echte Quelle alle paar
# Minuten einen echten Preis - in der Alarmliste steht dann fast nur
# Erfundenes. Abschalten mit:  ./scripts/no-simulation.sh
#
# Steht hier eine echte Quelle und fehlen ihre Zugangsdaten, wird NICHT auf die
# Simulation ausgewichen. Der Scanner bleibt stumm und schreibt den Grund ins
# Log - erfundene Daten in einem Werkzeug für echte Fehlpreise wären schlimmer.
PROVIDERS=mock

# ------------------------------------------------- Provider: The Odds API
# Registrierung: https://the-odds-api.com  (kostenloses Kontingent)
ODDS_API_KEY=
ODDS_API_REGIONS=eu,uk
# Leer lassen = verfügbare Fußball-/Tennis-Keys werden automatisch ermittelt.
ODDS_API_SPORTS=
ODDS_API_MARKETS=h2h,totals
# KONTINGENT: ein Abruf kostet (Märkte x Regionen) Credits, und es wird je
# Wettbewerb einmal abgefragt. Bei 4 Wettbewerben x 2 Märkten x 2 Regionen
# sind das 16 Credits pro Durchlauf - das kostenlose Kontingent (500/Monat)
# ist damit nach etwa 30 Durchläufen leer.
#
# Deshalb drosselt sich der Provider selbst: er liest das Restkontingent aus
# dem Antwort-Header und wählt den Takt so, dass es bis Monatsende reicht.
# ODDS_API_POLL_INTERVAL ist dabei nur die Untergrenze.
#
# Vorher prüfen, was dein Key hergibt:
#   ./scripts/setup-provider.sh the_odds_api --key DEIN_KEY
ODDS_API_POLL_INTERVAL=60
ODDS_API_PACE_TO_QUOTA=true
ODDS_API_QUOTA_RESERVE=20
# Jeder zusätzliche Wettbewerb kostet eigene Credits pro Durchlauf.
ODDS_API_MAX_DISCOVERED_SPORTS=4
# Der Scores-Endpunkt kostet zusätzlich 2 Credits je Wettbewerb und Abruf.
ODDS_API_USE_SCORES=true
ODDS_API_SCORES_INTERVAL=300
ODDS_API_MIN_REMAINING=5

# ------------------------------------------------- Provider: Betfair Exchange
# Registrierung: https://developer.betfair.com
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Für den zertifikatsbasierten Login (empfohlen, längere Sessions):
BETFAIR_CERT_FILE=
BETFAIR_KEY_FILE=
BETFAIR_EVENT_TYPE_IDS=1,2
BETFAIR_MARKET_TYPES=MATCH_ODDS,OVER_UNDER_25,BOTH_TEAMS_TO_SCORE,DOUBLE_CHANCE,DRAW_NO_BET,SET_WINNER
BETFAIR_POLL_INTERVAL=1.0
BETFAIR_INPLAY_ONLY=false

# ----------------------------------------------------- Provider: Mock/Demo
MOCK_TICK_INTERVAL=0.35
MOCK_EVENTS=8
MOCK_BOOKMAKERS=7
MOCK_ERROR_PROBABILITY=0.02
# Feste Zahl = reproduzierbarer Verlauf (für Tests/Demos)
# MOCK_SEED=42

# =============================================================== SCHWELLEN
# Ab wann ein Alarm ausgelöst wird. Niedriger = mehr Signale + mehr Rauschen.
MIN_VALUE_PERCENT=10
MIN_OUTLIER_PERCENT=15
MIN_BOOKMAKERS=3
MIN_ODDS=1.50
MAX_ODDS=51.0
# Bei echten Quellen mit Polling muss dieser Wert deutlich höher stehen als
# bei der Simulation - sonst gelten alle Quoten als veraltet und es entstehen
# nie Alarme. Faustregel: mindestens das Doppelte des Poll-Intervalls.
MAX_ODDS_AGE_SECONDS=10
ALERT_COOLDOWN_SECONDS=60
MIN_CONFIDENCE=60
MIN_ERROR_SCORE=60
# Märkte jenseits dieser Wahrscheinlichkeit gelten als entschieden
MAX_FAIR_PROBABILITY=0.97
SCAN_LIVE=true
SCAN_PREMATCH=true
SPORTS_ENABLED=football,tennis

# ------------------------------------------------------- Bewegungsalarme
MOVE_ALERTS_ENABLED=true
MOVE_ALERT_PERCENT=12
MOVE_ALERT_WINDOW=30
MOVE_ALERT_COOLDOWN=120
# Zieht der ganze Markt in dieselbe Richtung, ist eine hohe Einzelquote
# meist nur schneller - solche Alarme werden unterdrückt.
MARKET_DRIFT_WINDOW=20
MARKET_DRIFT_SUPPRESS_PERCENT=4
# Springt ein einzelnes Buch stärker als das, ohne dass der Markt folgt, führt
# es die Bewegung an (Tor/Karte) - das ist kein Fehlpreis, sondern das
# schnellste Buch. Der Fehler ist immer der Nachzügler.
MARKET_SHOCK_PERCENT=25
# Bestätigungsintervall für unveränderte Quoten. Ohne das würde eine stehen
# gebliebene (= vergessene) Quote künstlich als "stale" gelten.
QUOTE_REFRESH_SECONDS=5

# ------------------------------------------------ Alarm-Nachverfolgung
# Jeder Alarm wird nach einer Wartezeit erneut gegen den Markt gehalten:
# hat der Buchmacher korrigiert (echter Fehlpreis), ist der Markt nachgezogen
# (nur ein schnelleres Buch) oder steht der Preis noch? Das kostet KEINEN
# zusätzlichen API-Aufruf - es wird nur erneut angesehen, was in Redis liegt.
FOLLOWUP_ENABLED=true
# Muss UNTER ODDS_STATE_TTL_SECONDS liegen, sonst ist der Vergleichsmarkt
# beim Auswerten schon abgelaufen und jedes Urteil lautet "offen".
FOLLOWUP_AFTER_SECONDS=300
FOLLOWUP_INTERVAL_SECONDS=30
FOLLOWUP_BATCH=200
# Ab dieser Änderung gilt ein Preis als bewegt (Prozentpunkte).
FOLLOWUP_MOVE_PERCENT=2.0

# ================================================================== SCANNER
SCANNER_WORKERS=4
SCANNER_QUEUE_SIZE=20000
DB_WRITER_BATCH=200
DB_WRITER_INTERVAL=1.0
ODDS_STATE_TTL_SECONDS=900
# 0 = keine Snapshots speichern, 1 = jede Änderung, N = jede N-te Charge
SNAPSHOT_PERSIST_EVERY=1
PROVIDER_HEALTH_INTERVAL=5
RETENTION_SNAPSHOT_DAYS=7
RETENTION_ALERT_DAYS=30

# ====================================================================== API
API_PORT=8000
API_DOCS_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=240
# Keine Wildcard: exakt die Origins des Dashboards eintragen.
API_CORS_ORIGINS=http://localhost:8080
API_WS_MAX_CLIENTS=200

# ================================================================ DASHBOARD
DASHBOARD_PORT=8080

# Zugangsschutz fürs Dashboard (Basic Auth für Dashboard, API und WebSocket).
# LEER = jeder mit der Adresse sieht alles. Wenn der Port aus dem Internet
# erreichbar ist, unbedingt setzen:
#
#   ./scripts/set-dashboard-password.sh
#
# Format: benutzer:hash - niemals das Klartextpasswort eintragen.
#
# WICHTIG bei Handarbeit: jedes $ im Hash muss VERDOPPELT werden. Docker
# Compose liest $NAME in dieser Datei als Variable, und ein apr1-Hash besteht
# fast nur aus solchen Stellen - unverdoppelt bleibt von
#
#   DASHBOARD_AUTH=admin:$apr1$frYtsx1F$gU557er1Q0RlYieQT4Y461
#
# beim Start nur noch "admin:" übrig, und jede korrekte Anmeldung wird
# abgewiesen. Richtig ist:
#
#   DASHBOARD_AUTH=admin:$$apr1$$frYtsx1F$$gU557er1Q0RlYieQT4Y461
#
# Das Skript oben macht das von selbst - und prüft anschließend nach.
DASHBOARD_AUTH=
