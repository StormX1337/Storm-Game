# ============================================================================
#  Storm Odds Sniper - Konfiguration
#  Kopieren nach .env und anpassen:  cp .env.example .env
#  Die .env gehört NIEMALS ins Git (siehe .gitignore).
# ============================================================================

# ---------------------------------------------------------------- Allgemein
ENVIRONMENT=production
LOG_LEVEL=INFO
# true = JSON-Logs (für Loki/ELK), false = lesbare Konsolenausgabe
LOG_JSON=true

# ---------------------------------------------------------------- Datenbank
POSTGRES_DB=storm
POSTGRES_USER=storm
# PFLICHT: sicheres Passwort setzen, z. B. mit  openssl rand -base64 24
POSTGRES_PASSWORD=
# Optional: vollständige DSN, überschreibt die Einzelwerte oben
# DATABASE_URL=postgresql+asyncpg://storm:passwort@postgres:5432/storm

# -------------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=512mb

# ----------------------------------------------------------------- Telegram
# Token vom @BotFather. Ohne Token startet nur der Telegram-Worker nicht -
# Scanner, API und Dashboard laufen weiter.
TELEGRAM_BOT_TOKEN=
# Ziel-Chat für Alarme (eigene ID über @userinfobot; Gruppen-IDs sind negativ).
# Mehrere Chats kommagetrennt.
TELEGRAM_CHAT_ID=
# Telegram-IDs mit Adminrechten (kommagetrennt)
TELEGRAM_ADMIN_IDS=
# Bewegungsalarme zusätzlich per Telegram schicken (Standard: nur Dashboard)
TELEGRAM_SEND_MOVES=false
# Mindestgrad für den Chat aus TELEGRAM_CHAT_ID. Wer den Bot mit /start
# eingerichtet hat, hat eigene Filter und ist davon nicht betroffen.
#
# Der Standard-Chat hatte gar keinen Filter: er bekam jeden Alarm. Auf einem
# echten Server waren das 166 in 30 Minuten, davon KEINER spielbar. Eine
# Push-Nachricht für etwas zu schicken, das man gleichzeitig "nicht spielen"
# nennt, ist ein Widerspruch - "weak" wirft genau diese raus.
#   any = alles (altes Verhalten) · weak · moderate · strong
TELEGRAM_MIN_GRADE=weak

# ================================================================= PROVIDER
# Kommagetrennte Liste aktiver Datenquellen.
#   the_odds_api  - the-odds-api.com, API-Key nötig
#   sportsgameodds - sportsgameodds.com, API-Key nötig, echter LIVE-Filter
#   betfair       - Betfair Exchange, Konto + App-Key nötig
# Mehrere Quellen parallel:  PROVIDERS=sportsgameodds,betfair
#
# Fehlen die Zugangsdaten der hier genannten Quelle, bleibt der Scanner stumm
# und schreibt den Grund ins Log. Es gibt keine Ersatzquelle - erfundene Daten
# in einem Werkzeug für echte Fehlpreise wären schlimmer als gar keine.
PROVIDERS=sportsgameodds

# ------------------------------------------------- Provider: The Odds API
# Registrierung: https://the-odds-api.com  (kostenloses Kontingent)
ODDS_API_KEY=
ODDS_API_REGIONS=eu,uk
# Leer lassen = verfügbare Fußball-/Tennis-Keys werden automatisch ermittelt.
ODDS_API_SPORTS=
ODDS_API_MARKETS=h2h,totals
# KONTINGENT: ein Abruf kostet (Märkte x Regionen) Credits, und es wird je
# Wettbewerb einmal abgefragt. Bei 4 Wettbewerben x 2 Märkten x 2 Regionen
# sind das 16 Credits pro Durchlauf - das kostenlose Kontingent (500/Monat)
# ist damit nach etwa 30 Durchläufen leer.
#
# Deshalb drosselt sich der Provider selbst: er liest das Restkontingent aus
# dem Antwort-Header und wählt den Takt so, dass es bis Monatsende reicht.
# ODDS_API_POLL_INTERVAL ist dabei nur die Untergrenze.
#
# Vorher prüfen, was dein Key hergibt:
#   ./scripts/setup-provider.sh the_odds_api --key DEIN_KEY
ODDS_API_POLL_INTERVAL=60
ODDS_API_PACE_TO_QUOTA=true
ODDS_API_QUOTA_RESERVE=20
# Jeder zusätzliche Wettbewerb kostet eigene Credits pro Durchlauf.
ODDS_API_MAX_DISCOVERED_SPORTS=4
# Der Scores-Endpunkt kostet zusätzlich 2 Credits je Wettbewerb und Abruf.
ODDS_API_USE_SCORES=true
ODDS_API_SCORES_INTERVAL=300
ODDS_API_MIN_REMAINING=5

# ---------------------------------------------- Provider: SportsGameOdds
# https://sportsgameodds.com - REST-API mit echtem Live-Filter (live=true).
# Liefert je Markt die Preise aller Buchmacher in EINEM Aufruf. Quoten kommen
# im amerikanischen Format ("-110") und werden intern in Dezimalquoten
# umgerechnet. Key holen und alles in einem Rutsch prüfen:
#   ./scripts/setup-provider.sh sportsgameodds --key DEIN_KEY --live
SGO_API_KEY=
SGO_SPORT_IDS=SOCCER,TENNIS
# Konkrete Ligen sparen Kontingent, z. B. EPL,BUNDESLIGA
SGO_LEAGUES=
# true = ausschliesslich laufende Events
SGO_LIVE_ONLY=false
# Poll-Takt in Sekunden. Ein Durchlauf kostet SGO_MAX_PAGES Anfragen; der
# Adapter drosselt sich automatisch so, dass SGO_RATE_LIMIT_PER_MINUTE
# eingehalten wird. Pro-Tarif: 300/min, also sind 5 s bei 3 Seiten
# (= 36 Anfragen/min) sehr entspannt.
SGO_POLL_INTERVAL=5
SGO_MAX_PAGES=3
SGO_PAGE_LIMIT=100
# Anfragen pro Minute laut Tarif. 0 = keine Drosselung.
#   Free/Amateur: 10   ·   All-Star: 60   ·   Pro: 300
SGO_RATE_LIMIT_PER_MINUTE=300
SGO_BOOKMAKERS=

# ------------------------------------------------- Provider: Betfair Exchange
# Registrierung: https://developer.betfair.com
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Für den zertifikatsbasierten Login (empfohlen, längere Sessions):
BETFAIR_CERT_FILE=
BETFAIR_KEY_FILE=
BETFAIR_EVENT_TYPE_IDS=1,2
BETFAIR_MARKET_TYPES=MATCH_ODDS,OVER_UNDER_25,BOTH_TEAMS_TO_SCORE,DOUBLE_CHANCE,DRAW_NO_BET,SET_WINNER
BETFAIR_POLL_INTERVAL=1.0
BETFAIR_INPLAY_ONLY=false

# =============================================================== SCHWELLEN
# Ab wann ein Alarm ausgelöst wird. Niedriger = mehr Signale + mehr Rauschen.
MIN_VALUE_PERCENT=10
MIN_OUTLIER_PERCENT=15
MIN_BOOKMAKERS=3
MIN_ODDS=1.50
MAX_ODDS=51.0
# Bei echten Quellen mit Polling muss dieser Wert deutlich höher stehen als
# bei der Simulation - sonst gelten alle Quoten als veraltet und es entstehen
# nie Alarme. Faustregel: mindestens das Doppelte des Poll-Intervalls.
MAX_ODDS_AGE_SECONDS=10
ALERT_COOLDOWN_SECONDS=60
MIN_CONFIDENCE=60
MIN_ERROR_SCORE=60
# Märkte jenseits dieser Wahrscheinlichkeit gelten als entschieden
MAX_FAIR_PROBABILITY=0.97
SCAN_LIVE=true
SCAN_PREMATCH=true

# ----------------------------------------------------------- Vor dem Anpfiff
# Prematch ist ein anderer Markt als Live: mehr Buchmacher, alle hatten Tage
# Zeit, die Preise stehen dichter beieinander. Mit den Live-Schwellen käme
# darum fast nichts durch - deshalb eigene. Leer lassen = wie live.
#
# AUS als Standard, weil es zusätzliches API-Kontingent kostet. Der Live-Abruf
# bleibt davon unberührt: Prematch bekommt einen eigenen, langsamen Strom mit
# eigenem Seitenbudget, sonst würden die vielen kommenden Spiele die laufenden
# aus dem gemeinsamen Kontingent verdrängen.
PREMATCH_ENABLED=false
# Preise vor dem Anpfiff bewegen sich in Minuten, nicht in Sekunden.
PREMATCH_POLL_INTERVAL=60
PREMATCH_MAX_PAGES=2
# Startwerte, kein Naturgesetz - mit ./scripts/backtest.sh an den eigenen
# Daten prüfen und dann anpassen.
PREMATCH_MIN_VALUE_PERCENT=4
PREMATCH_MIN_OUTLIER_PERCENT=6
PREMATCH_MIN_BOOKMAKERS=5
# Abkühlzeit vor dem Anpfiff - viel länger als live (60 s), und zwar aus
# gemessenem Grund: eine Fehlquote, die stundenlang steht, zappelt dabei um
# ein, zwei Cent. Jede Winzigkeit ist eine Änderung und nach Ablauf der Sperre
# ein neuer Alarm. Mit den Live-Werten wären das rund 180 Nachrichten für EINE
# Wette, die drei Stunden gültig ist.
PREMATCH_ALERT_COOLDOWN=1800
# Wie lange ein Prematch-Alarm eine Empfehlung bleibt. Für Live gilt
# EVENT_STALE_SECONDS (180 s) - eine Live-Quote steht keine drei Minuten. Vor
# dem Anpfiff steht dieselbe Quote stundenlang; mit der Live-Frist war die
# Empfehlungskarte dort praktisch immer leer. Angepfiffene Spiele fliegen
# unabhängig davon raus - dann gilt der Vorab-Preis ohnehin nicht mehr.
PREMATCH_MAX_ALERT_AGE=3600
# Nachkontrolle vor dem Anpfiff: gegen die Linie kurz vor Anpfiff statt fünf
# Minuten nach dem Alarm. Gemessen: nach fünf Minuten ist der CLV exakt der
# gemeldete Vorteil nochmal und das Urteil immer "held" - also nichts. Der
# Anpfiff ist ohnehin, wogegen "Closing Line Value" gemessen gehört.
PREMATCH_FOLLOWUP_AT_KICKOFF=true
PREMATCH_FOLLOWUP_LEAD_SECONDS=120
# Ohne gelieferte Anstoßzeit bleibt nur ein fester, längerer Abstand.
PREMATCH_FOLLOWUP_AFTER_SECONDS=3600
# Quotenalter für Empfehlungen vor dem Anpfiff. Live gilt
# RECOMMEND_MAX_ODDS_AGE (15 s) - vor dem Anpfiff wäre das unsinnig, weil der
# Prematch-Abruf nur jede Minute läuft und jede Quote damit älter ist.
PREMATCH_RECOMMEND_MAX_ODDS_AGE=300
# Wie weit nach vorn geschaut wird, in Stunden. 24 = heute und heute Nacht.
# 0 = ohne Grenze.
#
# Der Abruf fragt "alles, was nicht beendet ist" - das schließt Spiele in zwei
# Wochen ein. Bei zwei Seiten à 100 Events können die Spiele von HEUTE dabei
# nie ankommen, und man merkt es nicht: die Liste ist ja voll. Ein Preis für
# übernächsten Samstag ist ohnehin wertlos, er steht bis dahin zehnmal anders.
PREMATCH_HORIZON_HOURS=24
SPORTS_ENABLED=football,tennis
# Nur bei DIESEN Buchmachern melden. Leer = bei allen.
#
# Wichtig: der Filter greift am ALARM, nicht am Abruf. Die faire Quote lebt
# davon, viele Bücher zu vergleichen - wer die Quelle einschränkt
# (SGO_BOOKMAKERS), macht seine Referenz schlechter und findet WENIGER
# Fehlpreise. Hier bleibt die Referenz vollständig, gemeldet wird nur, was
# man auch spielen kann.
#
# Welche Namen es bei dir gibt, zeigt ./scripts/bookmakers.sh - sie werden
# nicht geraten, sondern aus den eigenen Daten gelesen.
ALERT_BOOKMAKERS=

# ------------------------------------------------------- Bewegungsalarme
MOVE_ALERTS_ENABLED=true
MOVE_ALERT_PERCENT=12
MOVE_ALERT_WINDOW=30
MOVE_ALERT_COOLDOWN=120
# Zieht der ganze Markt in dieselbe Richtung, ist eine hohe Einzelquote
# meist nur schneller - solche Alarme werden unterdrückt.
MARKET_DRIFT_WINDOW=20
MARKET_DRIFT_SUPPRESS_PERCENT=4
# Springt ein einzelnes Buch stärker als das, ohne dass der Markt folgt, führt
# es die Bewegung an (Tor/Karte) - das ist kein Fehlpreis, sondern das
# schnellste Buch. Der Fehler ist immer der Nachzügler.
MARKET_SHOCK_PERCENT=25
# Bestätigungsintervall für unveränderte Quoten. Ohne das würde eine stehen
# gebliebene (= vergessene) Quote künstlich als "stale" gelten.
QUOTE_REFRESH_SECONDS=5
# Ab diesem Alter gilt ein Event nicht mehr als live. Wichtig, weil ein
# beendetes Spiel bei den üblichen Quellen KEIN "beendet" meldet - es
# verschwindet einfach aus der Antwort. Ohne diese Grenze stünde ein fertiges
# Match noch eine Stunde als laufend im Dashboard. Behauptet wird trotzdem
# nicht "beendet" (das wissen wir nicht), nur "keine frischen Daten".
EVENT_STALE_SECONDS=180
# Dieselbe Frist gilt für die Empfehlungsliste: ein älterer Alarm ist keine
# Empfehlung mehr, sondern Geschichte - der Preis steht so nicht mehr.

# ------------------------------------------------ Alarm-Nachverfolgung
# Jeder Alarm wird nach einer Wartezeit erneut gegen den Markt gehalten:
# hat der Buchmacher korrigiert (echter Fehlpreis), ist der Markt nachgezogen
# (nur ein schnelleres Buch) oder steht der Preis noch? Das kostet KEINEN
# zusätzlichen API-Aufruf - es wird nur erneut angesehen, was in Redis liegt.
FOLLOWUP_ENABLED=true
# Muss UNTER ODDS_STATE_TTL_SECONDS liegen, sonst ist der Vergleichsmarkt
# beim Auswerten schon abgelaufen und jedes Urteil lautet "offen".
FOLLOWUP_AFTER_SECONDS=300
FOLLOWUP_INTERVAL_SECONDS=30
FOLLOWUP_BATCH=200
# Ab dieser Änderung gilt ein Preis als bewegt (Prozentpunkte).
FOLLOWUP_MOVE_PERCENT=2.0

# ----------------------------------------------------------- Empfehlung
# Aus jedem Alarm wird eine Handlungsempfehlung: spielen, kleiner Einsatz,
# nur beobachten oder sein lassen - mit Einsatzgröße. Es wird nichts
# gesetzt; das ist eine Rechnung, keine Wette.
RECOMMEND_ENABLED=true
# Bankroll in Kontowährung. 0 = nicht hinterlegt; dann nennt die Empfehlung
# nur Prozentwerte und erfindet keinen Betrag.
BANKROLL=0
# Anteil des vollen Kelly-Einsatzes. Voller Kelly (1.0) unterstellt, die
# geschätzte Wahrscheinlichkeit sei exakt - sie ist es nie. 0.25 ist der
# übliche Kompromiss zwischen Wachstum und Ruinrisiko.
KELLY_FRACTION=0.25
# Deckel je Wette und über die ganze Empfehlungsliste (Prozent der Bankroll).
MAX_STAKE_PERCENT=2.0
MAX_TOTAL_STAKE_PERCENT=6.0
# Größenordnung eines Vorteils, den es real geben kann. WICHTIG: alles weit
# darüber wird ABGEWERTET, nicht hochsortiert. Eine Quote 200 % über dem
# Markt ist fast nie ein Vorteil, sondern eine falsche Linie, ein alter
# Preis oder ein anderer Markt. Größer machen heißt: mehr Datenfehler
# landen in der Empfehlungsliste.
PLAUSIBLE_EDGE_PERCENT=8.0
# Dieselbe Grenze für belegte Fehlpreise (hoher Error-Score). Dort darf der
# Abstand größer sein - die Behauptung ist ja gerade, dass ein Buch falsch liegt.
MAX_PLAUSIBLE_EDGE_PERCENT=18.0
# Darüber wird ohne Rechnung abgelehnt.
ABSURD_EDGE_PERCENT=60.0
# Mindestmaß, damit überhaupt eine Empfehlung entsteht.
RECOMMEND_MIN_CONFIDENCE=65
RECOMMEND_MIN_BOOKMAKERS=4
RECOMMEND_MAX_ODDS_AGE=15
# Wetten je Event. Zwei Selektionen desselben Spiels hängen zusammen - im
# Extremfall wären es Über UND Unter.
RECOMMEND_MAX_PICKS_PER_EVENT=1
RECOMMEND_LIMIT=10

# -------------------------------------------------------- Sichere Wetten
# Widersprechen sich die Buchmacher untereinander, ist der Gewinn Arithmetik
# statt Schätzung: alle Ausgänge zum jeweils besten Preis, Summe der
# Gegenwahrscheinlichkeiten unter 100 %. Kostet KEINEN zusätzlichen Abruf -
# es wird nur zusätzlich angesehen, was ohnehin schon einläuft.
ARBITRAGE_ENABLED=true
# Darunter lohnt der Aufwand nicht, und Rundung erzeugt Scheinfunde.
ARBITRAGE_MIN_PROFIT_PERCENT=0.5
# Darüber ist es praktisch immer ein Datenfehler (falsche Linie, alter
# Preis). Solche Funde werden als Verdacht ausgewiesen, nicht angepriesen.
ARBITRAGE_MAX_PROFIT_PERCENT=12
# Beide Seiten müssen frisch sein - eine alte Quote ist keine Wette.
ARBITRAGE_MAX_AGE=15
# Anteil des NETTOGEWINNS, den eine Börse einbehält (Betfair: 2-5 %).
# Wichtig: reale Arbitragen liegen bei 0,5-3 %, also regelmäßig UNTER dieser
# Gebühr. Ohne Abzug würde ein Verlust als risikofrei ausgewiesen. Lieber zu
# hoch als zu niedrig ansetzen.
ARBITRAGE_EXCHANGE_COMMISSION=0.05
# Darunter gilt eine Quote als zu dünn, um den Einsatz aufzunehmen.
# 0 = nicht prüfen. Unbekannte Liquidität zählt nie als dünn.
ARBITRAGE_MIN_LIQUIDITY=0
# Wie lange ein Fund im Dashboard stehen bleibt, und wie lange bis zur
# nächsten Meldung zum selben Markt.
ARBITRAGE_TTL_SECONDS=120
ARBITRAGE_COOLDOWN_SECONDS=300
ARBITRAGE_TELEGRAM=true

# --------------------------------------------------------- Wett-Tagebuch
# Festhalten, was tatsächlich gespielt wurde - und was dabei herauskam. Das
# ist eine andere Frage als die Trefferbilanz: die misst, ob die ALARME
# etwas taugten. Der Bot setzt weiterhin nichts, er führt Buch.
BETLOG_ENABLED=true
# Schreibzugriff über die HTTP-API (der Knopf "Gespielt" im Dashboard).
# Standard AUS, und das mit Absicht: die API ist genau so geschützt wie das
# Dashboard davor. Steht das offen im Netz, kann jeder Wetten in dein
# Tagebuch eintragen. Erst ./scripts/set-dashboard-password.sh laufen
# lassen, dann hier einschalten. Über Telegram geht es immer - dort ist der
# Absender bekannt.
BETLOG_API_WRITES=false

# ================================================================== SCANNER
SCANNER_WORKERS=4
SCANNER_QUEUE_SIZE=20000
DB_WRITER_BATCH=200
DB_WRITER_INTERVAL=1.0
ODDS_STATE_TTL_SECONDS=900
# 0 = keine Snapshots speichern, 1 = jede Änderung, N = jede N-te Charge
SNAPSHOT_PERSIST_EVERY=1
PROVIDER_HEALTH_INTERVAL=5
RETENTION_SNAPSHOT_DAYS=7
RETENTION_ALERT_DAYS=30

# ====================================================================== API
API_PORT=8000
API_DOCS_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=240
# Keine Wildcard: exakt die Origins des Dashboards eintragen.
API_CORS_ORIGINS=http://localhost:8080
API_WS_MAX_CLIENTS=200

# ================================================================ DASHBOARD
DASHBOARD_PORT=8080

# Zugangsschutz fürs Dashboard (Basic Auth für Dashboard, API und WebSocket).
# LEER = jeder mit der Adresse sieht alles. Wenn der Port aus dem Internet
# erreichbar ist, unbedingt setzen:
#
#   ./scripts/set-dashboard-password.sh
#
# Format: benutzer:hash - niemals das Klartextpasswort eintragen.
#
# WICHTIG bei Handarbeit: jedes $ im Hash muss VERDOPPELT werden. Docker
# Compose liest $NAME in dieser Datei als Variable, und ein apr1-Hash besteht
# fast nur aus solchen Stellen - unverdoppelt bleibt von
#
#   DASHBOARD_AUTH=admin:$apr1$frYtsx1F$gU557er1Q0RlYieQT4Y461
#
# beim Start nur noch "admin:" übrig, und jede korrekte Anmeldung wird
# abgewiesen. Richtig ist:
#
#   DASHBOARD_AUTH=admin:$$apr1$$frYtsx1F$$gU557er1Q0RlYieQT4Y461
#
# Das Skript oben macht das von selbst - und prüft anschließend nach.
DASHBOARD_AUTH=
